<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="loan_application_tag_vip" model="loan.application.tag">
            <field name="name">VIP</field>
        </record>

        <record
            id="loan_application_tag_first_time_buyer"
            model="loan.application.tag"
        >
            <field name="name">First-Time Buyer</field>
        </record>

        <record
            id="document_type_proof_identity"
            model="loan.application.document.type"
        >
            <field name="name">Proof of Identity</field>
            <field name="is_required" eval="True"/>
        </record>

        <record
            id="document_type_proof_income"
            model="loan.application.document.type"
        >
            <field name="name">Proof of Income</field>
            <field name="is_required" eval="True"/>
        </record>
    </data>
</odoo>
