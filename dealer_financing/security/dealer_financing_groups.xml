<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dealership" model="ir.module.category">
        <field name="name">Dealership</field>
    </record>

    <record id="res_groups_privilege_financing" model="res.groups.privilege">
        <field name="name">Financing</field>
        <field name="category_id" ref="module_category_dealership"/>
    </record>

    <record id="group_dealer_financing_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_financing"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_dealer_financing_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_financing"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dealer_financing_user'))]"/>
    </record>
</odoo>
