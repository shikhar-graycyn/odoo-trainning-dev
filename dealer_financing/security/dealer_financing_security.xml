<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loan_application_user_signed_rule" model="ir.rule">
        <field name="name">Loan applications: users cannot modify signed loans</field>
        <field name="model_id" ref="model_loan_application"/>
        <field name="groups" eval="[Command.link(ref('group_dealer_financing_user'))]"/>
        <field name="domain_force">[("state", "not in", ["signed"])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="loan_application_admin_all_rule" model="ir.rule">
        <field name="name">Loan applications: admins can modify all loans</field>
        <field name="model_id" ref="model_loan_application"/>
        <field name="groups" eval="[Command.link(ref('group_dealer_financing_admin'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
