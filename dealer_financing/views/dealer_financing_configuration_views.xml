<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_application_tag_list" model="ir.ui.view">
        <field name="name">loan.application.tag.list</field>
        <field name="model">loan.application.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <record id="action_loan_application_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">loan.application.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_loan_application_document_type_list" model="ir.ui.view">
        <field name="name">loan.application.document.type.list</field>
        <field name="model">loan.application.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="is_required"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_loan_application_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">loan.application.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
