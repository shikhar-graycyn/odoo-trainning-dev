<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_application_list" model="ir.ui.view">
        <field name="name">loan.application.list</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="loan_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_loan_application_form" model="ir.ui.view">
        <field name="name">loan.application.form</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_approve_loan"
                        type="object"
                        string="Approve"
                        invisible="state != 'sent'"
                    />
                    <button
                        name="action_reject_loan"
                        type="object"
                        string="Reject"
                        invisible="state != 'sent'"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="user_id"/>
                            <field name="product_id"/>
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                        </group>
                        <group>
                            <field name="date_applied"/>
                            <field name="date_approved"/>
                            <field name="date_rejected"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Financials">
                        <field name="currency_id" invisible="1"/>
                        <group>
                            <field name="principal_amount" widget="monetary"/>
                            <field name="down_payment" widget="monetary"/>
                            <field name="loan_amount" widget="monetary"/>
                        </group>
                        <group>
                            <field name="loan_term"/>
                            <field name="interest_rate"/>
                        </group>
                    </group>
                    <group string="Internal Notes">
                        <field
                            name="notes"
                            widget="html"
                            nolabel="1"
                            colspan="2"
                            placeholder="Add internal notes..."
                        />
                    </group>
                    <notebook>
                        <page string="Compliance Checklist">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="type_id"/>
                                    <field name="state"/>
                                    <field name="attachment_id"/>
                                    <button
                                        name="action_approve_document"
                                        type="object"
                                        string="Approve"
                                        icon="fa-check"
                                        invisible="state == 'approved'"
                                    />
                                    <button
                                        name="action_reject_document"
                                        type="object"
                                        string="Reject"
                                        icon="fa-times"
                                        invisible="state == 'rejected'"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_loan_application_search" model="ir.ui.view">
        <field name="name">loan.application.search</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="approved"
                    string="Approved"
                    domain="[('state', '=', 'approved')]"
                />
                <group>
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_loan_application" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loan.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_loan_application_search"/>
    </record>
</odoo>
