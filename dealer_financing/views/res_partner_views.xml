<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_dealer_financing" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.dealer.financing</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_loan_applications"
                    class="oe_stat_button"
                    icon="fa-money"
                >
                    <field
                        name="loan_application_count"
                        widget="statinfo"
                        string="Loan Applications"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
