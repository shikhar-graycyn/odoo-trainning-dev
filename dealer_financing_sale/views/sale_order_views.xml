<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dealer.financing.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    string="Create Loan"
                    name="action_create_loan"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'sale' or loan_application_count &gt; 0"
                />
            </header>
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_loan_applications"
                    type="object"
                    icon="fa-money"
                >
                    <field
                        name="loan_application_count"
                        widget="statinfo"
                        string="Loan Applications"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
